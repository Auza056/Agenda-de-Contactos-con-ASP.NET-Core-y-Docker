@model IEnumerable<VaultContactos.Models.Contacto>

@{
    ViewData["Title"] = "Vault de Contactos";
}

<div class="d-flex align-items-center justify-content-between mb-4 mt-3">
    <div>
        <h1 class="h3 text-light font-weight-bold mb-1">
            <svg class="octicon octicon-repo mr-2" viewBox="0 0 16 16" version="1.1" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.499 2.499 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"></path></svg>
            vault-contactos / <span class="text-info">directorio</span>
        </h1>
        <p class="text-secondary mb-0">Gestor seguro de contactos cifrado y contenerizado con Docker.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-github-primary">
            + Nuevo Contacto
        </a>
    </div>
</div>

<!-- Tarjeta de Resumen / Estadísticas (Función Extra) -->
<div class="github-card p-3 mb-4 d-flex justify-content-between align-items-center">
    <div>
        <span class="text-secondary small">REGISTROS TOTALES EN EL VAULT</span>
        <h4 class="text-light mb-0">@Model.Count() contactos almacenados</h4>
    </div>
    <div>
        <span class="badge bg-secondary text-light">Estado: Docker OK 🐳</span>
    </div>
</div>

<!-- Barra de Búsqueda -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Buscar por nombre o apellido..." value="@Context.Request.Query["searchString"]" />
        <button type="submit" class="btn btn-outline-info">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<!-- Tabla de Contactos Estilo GitHub -->
<div class="table-responsive table-dark-custom">
    <table class="table table-dark table-hover mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Empresa)</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-secondary">No se encontraron registros en el sistema.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model) {
                    <tr>
                        <td class="font-weight-bold text-light">@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td><a href="mailto:@item.Email" class="text-info">@Html.DisplayFor(modelItem => item.Email)</a></td>
                        <td><span class="badge bg-dark border border-secondary text-light">@Html.DisplayFor(modelItem => item.Empresa)</span></td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mr-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info mr-1">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>